{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
