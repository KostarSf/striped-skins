{
  "name": "striped-skins",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build:api": "npm run build --workspace ./packages/api",
    "build:viewer": "npm run build --workspace ./packages/viewer",
    "build:libs": "npm run build:api && npm run build:viewer",
    "build:app": "react-router build",
    "build": "npm run build:libs && npm run build:app",
    "dist:lib": "npm run build --workspace ./packages/browser-bundle",
    "dev": "react-router dev",
    "dev:lib": "npm run dev --workspace ./packages/browser-bundle",
    "start": "react-router-serve ./build/server/index.js",
    "preview:lib": "npm run preview --workspace ./packages/browser-bundle",
    "typecheck": "react-router typegen && tsc --noEmit",
    "predev": "npm run build:libs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "predev:lib": "npm run build:libs",
    "predist:lib": "npm run build:libs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@striped-skins/api": "^1.0.0",
    "@striped-skins/viewer": "^1.0.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "r3f-perf": {
      "@react-three/drei": "^10.7.9"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
